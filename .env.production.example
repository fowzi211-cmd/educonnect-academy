# Production environment template for Dr. Nada Center.
#
# How to use:
#   1. Copy this file to `.env` on the production server (NOT into git).
#   2. Run `php artisan key:generate` on the server to fill in APP_KEY —
#      never reuse a key from local dev or another environment.
#   3. Fill in every blank value below (APP_URL, DB_*, MAIL_*, and a real
#      payment gateway if you want online card payments; bank transfer needs
#      no keys here — it's configured from Admin > Finance > Bank Accounts).
#   4. Run `php artisan config:cache route:cache view:cache` after deploying.
#
# Everything below that isn't a blank/placeholder is already set correctly
# for production and shouldn't need to change.

APP_NAME="Dr. Nada Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://

APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PLATFORM_DEFAULT_CURRENCY=SDG
PLATFORM_SUPPORTED_LOCALES=en,ar

# Payment gateway: stays "test" until you configure Stripe or PayPal below —
# the app automatically hides the online-payment option in production while
# the gateway is still "test", so bank transfer keeps working safely either
# way. Fill these in only if you want real card payments in addition to bank
# transfer.
PAYMENT_GATEWAY=test
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYMENT_GRACE_PERIOD_DAYS=3

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite is fine for a small-to-medium deployment as long as it's backed up
# (see storage/backups and `php artisan app:backup`). Switch to mysql/pgsql
# here instead if you expect heavier concurrent write traffic.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Requires the site to actually be served over HTTPS (it should be, in production).
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Real SMTP credentials — until these are filled in, no notification or
# password-reset email actually reaches anyone (mail silently no-ops to the
# log). Get credentials from your provider (Gmail SMTP, Mailtrap, SendGrid,
# Postmark, etc.), then verify delivery with:
#   php artisan app:test-email you@example.com
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
